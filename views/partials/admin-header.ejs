<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin Panel' %> - Gourmet Bistro</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
  </style>
</head>
<body class="admin-layout">
  <!-- Admin Sidebar -->
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="admin-sidebar-header">
      <div class="admin-brand">
        <a href="/admin" class="admin-brand-title">
          <span style="font-size: 1.4rem;">🍴</span>
          <span>Gourmet<span style="color: #ea580c;">Bistro</span></span>
        </a>
        <span class="badge-tag">ADMIN</span>
      </div>
    </div>

    <ul class="admin-nav">
      <li class="admin-nav-item">
        <a href="/admin" class="admin-nav-link <%= currentPath === '/admin' ? 'active' : '' %>">
          <span>📊</span>
          <span>Dashboard & KPIs</span>
        </a>
      </li>
      <li class="admin-nav-item">
        <a href="/admin/orders" class="admin-nav-link <%= currentPath === '/admin/orders' ? 'active' : '' %>">
          <span>🍳</span>
          <span>Kitchen & Orders</span>
        </a>
      </li>
      <li class="admin-nav-item">
        <a href="/admin/tables" class="admin-nav-link <%= currentPath === '/admin/tables' ? 'active' : '' %>">
          <span>🪑</span>
          <span>Floor Plan & Tables</span>
        </a>
      </li>
      <li class="admin-nav-item">
        <a href="/admin/reservations" class="admin-nav-link <%= currentPath === '/admin/reservations' ? 'active' : '' %>">
          <span>📅</span>
          <span>Reservations Book</span>
        </a>
      </li>
      <li class="admin-nav-item">
        <a href="/admin/menu" class="admin-nav-link <%= currentPath === '/admin/menu' ? 'active' : '' %>">
          <span>📋</span>
          <span>Menu Management</span>
        </a>
      </li>
      <li class="admin-nav-item">
        <a href="/admin/inventory" class="admin-nav-link <%= currentPath === '/admin/inventory' ? 'active' : '' %>">
          <span>📦</span>
          <span>Inventory & Stock</span>
        </a>
      </li>
    </ul>

    <div class="admin-sidebar-footer">
      <a href="/" class="admin-view-site" target="_blank">
        <span>🌐</span>
        <span>View Customer Site ↗</span>
      </a>
    </div>
  </aside>

  <!-- Admin Main Workspace -->
  <div class="admin-main">
    <header class="admin-topbar">
      <div style="display: flex; align-items: center; gap: 14px;">
        <button id="adminSidebarToggle" class="btn btn-sm btn-secondary" style="display: none; padding: 6px 10px;" onclick="toggleAdminSidebar()">
          ☰
        </button>
        <h2 class="admin-topbar-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Management Console' %></h2>
      </div>
      <div class="admin-topbar-actions">
        <div style="font-size: 0.88rem; color: #64748b; font-weight: 500;">
          🕒 <%= new Date().toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) %>
        </div>
        <a href="/order" class="btn btn-sm btn-primary" target="_blank">+ New POS Order</a>
      </div>
    </header>

    <div class="admin-content">

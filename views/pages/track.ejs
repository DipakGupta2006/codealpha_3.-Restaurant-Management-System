<%- include('../partials/header') %>

<div class="container" style="padding-top: 40px; padding-bottom: 70px;">
  <div class="section-header">
    <h2>Track Your Order Status</h2>
    <p>Get live updates on kitchen preparation and dining room service</p>
  </div>

  <!-- Search Input Bar -->
  <div style="max-width: 550px; margin: 0 auto 35px;">
    <form id="trackOrderForm" style="display: flex; gap: 10px;">
      <input type="text" id="orderNumberInput" class="form-control" placeholder="Enter Order Number (e.g. ORD-1001)" value="<%= searchedOrderNumber %>" style="font-size: 1rem; text-transform: uppercase;" required>
      <button type="submit" class="btn btn-primary" style="white-space: nowrap;">Track Now 🔍</button>
    </form>
    <div style="display: flex; gap: 8px; justify-content: center; align-items: center; margin-top: 10px; font-size: 0.85rem; color: #64748b;">
      <span>Try demo orders:</span>
      <button type="button" class="btn btn-sm btn-secondary" onclick="document.getElementById('orderNumberInput').value='ORD-1001'; trackOrder('ORD-1001');" style="padding: 2px 8px; font-size: 0.78rem;">ORD-1001</button>
      <button type="button" class="btn btn-sm btn-secondary" onclick="document.getElementById('orderNumberInput').value='ORD-1002'; trackOrder('ORD-1002');" style="padding: 2px 8px; font-size: 0.78rem;">ORD-1002</button>
      <button type="button" class="btn btn-sm btn-secondary" onclick="document.getElementById('orderNumberInput').value='ORD-1003'; trackOrder('ORD-1003');" style="padding: 2px 8px; font-size: 0.78rem;">ORD-1003</button>
    </div>
  </div>

  <!-- Results Container -->
  <div id="tracking-result-container">
    <div style="text-align: center; padding: 50px 20px; background: #fff; border-radius: 16px; border: 1px dashed var(--border); max-width: 600px; margin: 0 auto;">
      <div style="font-size: 3rem; margin-bottom: 12px;">🧾</div>
      <h3 style="color: var(--dark); margin-bottom: 6px;">Enter your order number</h3>
      <p style="color: var(--text-muted); font-size: 0.95rem;">Enter the order number printed on your receipt or given upon online confirmation.</p>
    </div>
  </div>
</div>

<script src="/js/tracker.js"></script>

<%- include('../partials/footer') %>
